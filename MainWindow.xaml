                                <Button Style="{StaticResource RowButton}" Click="CompactProgress_Click">
                                    <Grid>
                                        <local:Icon Style="{StaticResource RowIcon}" Kind="Rim"/>
                                        <TextBlock Style="{StaticResource RowLabel}" Text="В компакте"/>
                                        <local:Segments x:Name="CompactProgressSegments" Style="{StaticResource RowSegments}" Labels="Выкл|Кольцо|Заливка"/>
                                    </Grid>
