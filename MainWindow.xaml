                <Grid x:Name="LanguageModal" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Top" Width="310" Height="410" Margin="0,8,0,0">
                    <Grid.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="LanguageModalScale" CenterX="155" CenterY="205"/>
                        </TransformGroup>
                    </Grid.RenderTransform>
                    <Border Background="#F2121218" CornerRadius="28" BorderBrush="#33FFFFFF" BorderThickness="1" ClipToBounds="True">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="50"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="20,0,16,0">
                                <TextBlock Text="Язык интерфейса" FontSize="15" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                                <Button Click="LanguageModal_Close" HorizontalAlignment="Right" VerticalAlignment="Center" Width="28" Height="28" Background="#26FFFFFF" BorderThickness="0">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="14">
                                                <local:Icon Kind="Cross" Width="10" Height="10" Fill="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>
                            <Border Grid.Row="0" Height="1" Background="#1AFFFFFF" VerticalAlignment="Bottom"/>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden" Margin="10,6,10,10">
                                <StackPanel x:Name="LanguageList"/>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>

            <!-- iOS Modal Coordinate Confirmation Alert -->
            <Grid x:Name="CoordConfirmOverlay" Visibility="Collapsed" IsHitTestVisible="False"
                  HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <!-- Dimmer background under the alert -->
                <Border x:Name="CoordConfirmDimmer" Background="#45000000" Opacity="0"
                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                        MouseLeftButtonDown="CoordConfirm_BackgroundClick"/>
                
                <!-- iOS Alert Card -->
                <Border x:Name="CoordConfirmCard" Width="280" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="#F01C1C1E" BorderBrush="#33FFFFFF" BorderThickness="1"
                        CornerRadius="24" Padding="20,20,20,16" RenderTransformOrigin="0.5,0.5">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="32" ShadowDepth="8" Direction="270" Opacity="0.5" Color="Black"/>
                    </Border.Effect>
                    <Border.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="CoordConfirmScale" ScaleX="1" ScaleY="1"/>
                            <TranslateTransform x:Name="CoordConfirmMove"/>
                        </TransformGroup>
                    </Border.RenderTransform>
                    <StackPanel>
                        <!-- iOS Title -->
                        <TextBlock Text="Применить позицию?" FontWeight="SemiBold" FontSize="17"
                                   Foreground="White" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,0,0,6"/>
                        <!-- iOS Description & Timer -->
                        <TextBlock x:Name="CoordConfirmTimerText" Text="Смещение было сильно изменено.&#x0a;Откат изменений через 8 с"
                                   FontSize="13" Foreground="#B0B0C0" TextWrapping="Wrap"
                                   HorizontalAlignment="Center" TextAlignment="Center" LineHeight="17" Margin="0,0,0,18"/>
                        <!-- iOS Action Buttons -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <!-- Cancel / Don't Allow -->
                            <Button x:Name="CoordConfirmCancelBtn" Grid.Column="0" Height="42" Click="CoordConfirm_Cancel"
                                    Background="#303036" BorderThickness="0" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="BtnBorder" Background="{TemplateBinding Background}" CornerRadius="14">
                                            <TextBlock Text="Отмена" FontWeight="Medium" FontSize="15" Foreground="White"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="BtnBorder" Property="Background" Value="#404048"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="BtnBorder" Property="Background" Value="#25252A"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            
                            <!-- Apply / Allow -->
                            <Button x:Name="CoordConfirmAcceptBtn" Grid.Column="2" Height="42" Click="CoordConfirm_Accept"
                                    Background="#007AFF" BorderThickness="0" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="BtnBorder" Background="{TemplateBinding Background}" CornerRadius="14">
                                            <TextBlock Text="Применить" FontWeight="SemiBold" FontSize="15" Foreground="White"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="BtnBorder" Property="Background" Value="#0A84FF"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="BtnBorder" Property="Background" Value="#0062CC"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>


        </Grid>
            </Grid>

            <Canvas x:Name="Shared" Visibility="Collapsed" Opacity="0">
                <Ellipse x:Name="ArtGlow" Width="96" Height="96" Opacity="0" IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="ArtGlowScale"/>
                            <TranslateTransform x:Name="ArtGlowMove"/>
                        </TransformGroup>
                    </Ellipse.RenderTransform>
                </Ellipse>
                <Grid x:Name="ArtSpot" Width="64" Height="64" MouseLeftButtonUp="Art_MouseLeftButtonUp">
                    <Grid.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="ArtSize"/>
                            <TranslateTransform x:Name="ArtMove"/>
                        </TransformGroup>
                    </Grid.RenderTransform>
                    <Border Background="{StaticResource ArtPlaceholder}">
                        <local:Icon Kind="Note" Width="30" Height="30" Fill="{StaticResource Dim}"/>
                    </Border>
                    <local:Cover x:Name="Art" Radius="16"/>
                </Grid>
                <local:CoverRing x:Name="ArtRing" Width="28" Height="28" Opacity="0" IsHitTestVisible="False">
                    <local:CoverRing.RenderTransform>
                        <TranslateTransform x:Name="ArtRingMove"/>
                    </local:CoverRing.RenderTransform>
                </local:CoverRing>
                <local:Equalizer x:Name="Eq" Bars="8" Few="5" Width="21" Height="16" IsHitTestVisible="False">
                    <local:Equalizer.RenderTransform>
                        <TranslateTransform x:Name="EqMove"/>
                    </local:Equalizer.RenderTransform>
                </local:Equalizer>
            </Canvas>

            <Canvas x:Name="GestureHints" IsHitTestVisible="False">
                <Border x:Name="LeanLeftHint" Width="24" Height="24" CornerRadius="12" Background="#36000000" Opacity="0" RenderTransformOrigin="0.5,0.5">
                    <Border.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="LeanLeftScale"/>
                            <TranslateTransform x:Name="LeanLeftMove"/>
                        </TransformGroup>
                    </Border.RenderTransform>
                    <local:Icon x:Name="LeanLeftIcon" Kind="Back" Width="11" Height="11" Fill="White"/>
                </Border>
                <Border x:Name="LeanRightHint" Width="24" Height="24" CornerRadius="12" Background="#36000000" Opacity="0" RenderTransformOrigin="0.5,0.5">
                    <Border.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="LeanRightScale"/>
                            <TranslateTransform x:Name="LeanRightMove"/>
                        </TransformGroup>
                    </Border.RenderTransform>
                    <local:Icon x:Name="LeanRightIcon" Kind="Chevron" Width="11" Height="11" Fill="White"/>
                </Border>
                <Border x:Name="PullHandle" Width="28" Height="3" CornerRadius="1.5" Background="White" Opacity="0" Visibility="Collapsed" UseLayoutRounding="False">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="PullHandleMove"/>
                    </Border.RenderTransform>
                </Border>
            </Canvas>



        <Border x:Name="Bubble" Width="78" Height="34" CornerRadius="17" Visibility="Collapsed"
                Background="Transparent" Padding="1"
                HorizontalAlignment="Center" VerticalAlignment="Top" RenderTransformOrigin="0,0"
                MouseEnter="Bubble_MouseEnter" MouseLeave="Bubble_MouseLeave"
                MouseLeftButtonDown="Bubble_MouseLeftButtonDown" MouseLeftButtonUp="Bubble_MouseLeftButtonUp">
            <Border.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="BubbleScale"/>
                    <TranslateTransform x:Name="BubbleMove"/>
                </TransformGroup>
            </Border.RenderTransform>
            <Grid x:Name="BubbleBody" ClipToBounds="True">
                <Grid x:Name="BubbleRecord" Width="76" HorizontalAlignment="Left">
                    <Ellipse x:Name="BubbleRecordDot" Width="9" Height="9" Fill="{StaticResource Red}"
                             HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0"/>
                    <local:Digits x:Name="BubbleRecordText" Text="0:00" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource Red}"
                                  HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"/>
                </Grid>
                <Grid x:Name="BubbleTimer" Width="76" HorizontalAlignment="Left">
                    <local:Ring x:Name="BubbleRing" Width="16" Height="16"
                                HorizontalAlignment="Left" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    <local:Digits x:Name="BubbleText" Text="25:00" FontSize="12.5" FontWeight="SemiBold"
                                  HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"/>
                </Grid>
                <StackPanel x:Name="BubbleShelf" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Margin="0,0,13,0">
                    <local:Icon Kind="Tray" Width="15" Height="15" VerticalAlignment="Center"/>
                    <local:Digits x:Name="BubbleShelfText" Text="0" FontSize="12.5" FontWeight="SemiBold"
                                  VerticalAlignment="Center" Margin="4,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
