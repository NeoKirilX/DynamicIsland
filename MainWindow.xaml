                                            </RadioButton>
                                            <RadioButton Style="{StaticResource Tile}" Tag="Волна" Click="LyricChangeTile_Click">
                                                <local:LyricPreview Change="Wave"/>
                                            </RadioButton>
                                            <RadioButton Style="{StaticResource Tile}" Tag="Барабан" Click="LyricChangeTile_Click">
                                                <local:LyricPreview Change="Drum"/>
                                            </RadioButton>
                                        </UniformGrid>
                                        <StackPanel Margin="6,6,6,6">
