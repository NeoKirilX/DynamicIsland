                            <Button Style="{StaticResource BackButton}" Content="QR И ТЕКСТ С ЭКРАНА" Click="SettingsBack_Click"/>
                        </local:RowList>
                        <TextBlock Text="РАСПОЗНАВАНИЕ QR" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Dim}" Margin="6,2,0,4"/>
                        <UniformGrid Rows="1" Margin="2,0,2,0">
                            <Button Style="{StaticResource ChipButton}" Height="36" FontSize="12.5" FontWeight="SemiBold"
                                    Content="Весь экран" Click="QrScreen_Click"/>
                            <Button Style="{StaticResource ChipButton}" Height="36" FontSize="12.5" FontWeight="SemiBold"
                                    Content="Выбрать область" Click="QrArea_Click"/>
                        </UniformGrid>
                        <TextBlock Text="ИЗВЛЕЧЬ ТЕКСТ (OCR)" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Dim}" Margin="6,8,0,4"/>
                        <UniformGrid Rows="1" Margin="2,0,2,0">
                            <Button Style="{StaticResource ChipButton}" Height="36" FontSize="12.5" FontWeight="SemiBold"
                                    Content="С экрана" Click="OcrScreen_Click"/>
                            <Button Style="{StaticResource ChipButton}" Height="36" FontSize="12.5" FontWeight="SemiBold"
                                    Content="Выбрать область" Click="OcrArea_Click"/>
                            <Button Style="{StaticResource ChipButton}" Height="36" FontSize="12.5" FontWeight="SemiBold"
