                                        <RadioButton Style="{StaticResource Tile}" Tag="Диск" Click="HoverTile_Click">
                                            <local:HoverPreview Kind="Disc"/>
                                        </RadioButton>
                                        <RadioButton Style="{StaticResource Tile}" Tag="Магнит" Click="HoverTile_Click">
                                            <local:HoverPreview Kind="Magnet"/>
                                        </RadioButton>
                                        <RadioButton Style="{StaticResource Tile}" Tag="Перетекание" Click="HoverTile_Click">
                                            <local:HoverPreview Kind="Flow"/>
                                        </RadioButton>
                                    </UniformGrid>
                                </Border>
                                <Border Style="{StaticResource RowDivider}"/>
                                <Grid Height="40" Margin="12,0">
                                    <local:Icon Style="{StaticResource RowIcon}" Kind="Drop"/>
                                    <TextBlock Style="{StaticResource RowLabel}" Text="Акцентный цвет" FontSize="13.5"/>
                                    <TextBlock x:Name="AccentText" FontSize="13.5" Foreground="{StaticResource Dim}"
