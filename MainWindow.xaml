                                                <local:Digits x:Name="LyricStaggerText" Foreground="{StaticResource Dim}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            </Grid>
                                            <Grid Height="34">
                                                <local:Icon Style="{StaticResource RowIcon}" Kind="Clock"/>
