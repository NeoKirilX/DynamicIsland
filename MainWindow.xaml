                                        <RadioButton Style="{StaticResource Tile}" Tag="Свечение" Click="BackdropTile_Click">
                                            <local:BackdropPreview Kind="Glow"/>
                                        </RadioButton>
                                        <RadioButton Style="{StaticResource Tile}" Tag="Матрица" Click="BackdropTile_Click">
                                            <local:BackdropPreview Kind="Matrix"/>
                                        </RadioButton>
                                        <RadioButton Style="{StaticResource Tile}" Tag="Звёзды" Click="BackdropTile_Click">
                                            <local:BackdropPreview Kind="Stars"/>
                                        </RadioButton>
                                        <RadioButton Style="{StaticResource Tile}" Tag="Вместе" Click="BackdropTile_Click">
                                            <local:BackdropPreview Kind="MatrixAndStars"/>
                                        </RadioButton>
                                        <RadioButton Style="{StaticResource Tile}" Tag="Обложка" Click="BackdropTile_Click">
